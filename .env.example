# Copy to .env.local (dev) or set in the Docker/host environment (production).

# Public site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://ufanstudio.com

# Contact form SMTP (Brevo relay). SMTP_PASS is the Brevo SMTP key, and SMTP_FROM must be a Brevo-verified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=
# Required with Brevo: the SMTP login is not a valid sender address.
SMTP_FROM="UFAN STUDIO <log@ufanstudio.com>"
# Optional: defaults to studio@ufanstudio.com
CONTACT_TO=studio@ufanstudio.com
